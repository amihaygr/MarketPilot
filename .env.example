# Copy this file to .env and replace placeholders locally.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=marketpilot
TZ=UTC
MARKET_TIMEZONE=America/New_York

# Market scope
MARKET_SYMBOLS=AAPL,MSFT,AMZN,NVDA,GOOGL,META,TSLA,JPM,UNH,XOM,SPY
MARKET_BAR_INTERVAL=1Min
MARKET_DATA_SOURCE=synthetic
SYNTHETIC_PUBLISH_SECONDS=60

# Alpaca
ALPACA_API_KEY=replace_me
ALPACA_API_SECRET=replace_me
ALPACA_DATA_FEED=iex
ALPACA_DATA_TIMEOUT_SECONDS=0
ALPACA_RECONNECT_INITIAL_SECONDS=1
ALPACA_RECONNECT_MAX_SECONDS=60
ALPACA_HISTORICAL_BASE_URL=https://data.alpaca.markets/v2/stocks/bars
ALPACA_HISTORICAL_TIMEOUT_SECONDS=30
ALPACA_HISTORICAL_MAX_ATTEMPTS=4
ALPACA_HISTORICAL_REQUESTS_PER_SECOND=2
ALPACA_HISTORICAL_PAGE_LIMIT=10000
HISTORICAL_BRONZE_WAIT_TIMEOUT_SECONDS=180
HISTORICAL_BRONZE_POLL_SECONDS=1
HISTORICAL_MINIMUM_COVERAGE_PCT=80
HISTORICAL_MAX_INGESTION_LAG_DAYS=3660

# SEC EDGAR
SEC_USER_AGENT=MarketPilot replace-with-contact@example.com
SEC_MAX_REQUESTS_PER_SECOND=5
SEC_POLL_ENABLED=false
SEC_BASE_URL=https://data.sec.gov
SEC_ALLOW_INSECURE_HTTP=false
SEC_REQUEST_TIMEOUT_SECONDS=30
SEC_REQUEST_MAX_ATTEMPTS=4
SEC_FORMS=10-K,10-Q,8-K
SEC_COMPANY_CIKS=AAPL:0000320193,MSFT:0000789019,AMZN:0001018724,NVDA:0001045810,GOOGL:0001652044,META:0001326801,TSLA:0001318605,JPM:0000019617,UNH:0000731766,XOM:0000034088,SPY:0000884394

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_MARKET_BARS_TOPIC=market.bars.1m.v1
KAFKA_HISTORICAL_BARS_TOPIC=market.bars.1m.backfill.v1
KAFKA_DEAD_LETTER_TOPIC=market.bars.1m.dlq.v1
KAFKA_CONSUMER_GROUP_STREAMING=marketpilot-spark-streaming-v1
KAFKA_CONSUMER_GROUP_RAW_ARCHIVE=marketpilot-raw-archive-v1

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me
MINIO_BRONZE_BUCKET=marketpilot-bronze
MINIO_SILVER_BUCKET=marketpilot-silver
MINIO_CHECKPOINT_BUCKET=marketpilot-checkpoints
MINIO_ANALYTICS_BUCKET=marketpilot-analytics
MINIO_ARCHIVE_BUCKET=marketpilot-archive
BRONZE_URI=s3a://marketpilot-bronze
SILVER_URI=s3a://marketpilot-silver
ARCHIVE_URI=s3a://marketpilot-archive

# MariaDB
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=marketpilot
MARIADB_ROOT_PASSWORD=replace_me
MARIADB_APP_USER=marketpilot_app
MARIADB_APP_PASSWORD=replace_me
MARIADB_INGEST_USER=marketpilot_ingest
MARIADB_INGEST_PASSWORD=replace_me
MARIADB_PUBLISH_USER=marketpilot_publisher
MARIADB_PUBLISH_PASSWORD=replace_me
MARIADB_SEC_USER=marketpilot_sec
MARIADB_SEC_PASSWORD=replace_me
MARIADB_JDBC_URL=jdbc:mariadb://mariadb:3306/marketpilot

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_STREAMING_TRIGGER_SECONDS=60
SPARK_CHECKPOINT_URI=s3a://marketpilot-checkpoints/market-bars-1m-v1
SPARK_LOG_LEVEL=WARN
MARKETPILOT_CODE_VERSION=development
BATCH_MAX_INGESTION_LAG_SECONDS=300

# Phase 8 operational monitoring. Webhook is optional and disabled by default.
OPERATIONS_CHECK_INTERVAL_SECONDS=60
OPERATIONS_MARKET_FRESHNESS_MAX_HOURS=96
OPERATIONS_SEC_FRESHNESS_MAX_HOURS=336
OPERATIONS_ALERT_WEBHOOK_URL=

# Airflow metadata database. This is separate from the business MariaDB.
AIRFLOW_METADATA_DATABASE_URL=postgresql+psycopg2://airflow:replace_me@airflow-db:5432/airflow
AIRFLOW_DB_PASSWORD=replace_me
AIRFLOW_FERNET_KEY=replace_me
AIRFLOW_SECRET_KEY=replace_me
AIRFLOW_TIMEZONE=America/New_York
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:replace_me@airflow-db:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace_me
AIRFLOW_ADMIN_EMAIL=replace-with-contact@example.com

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_MAX_MARKET_RANGE_DAYS=31
API_MAX_FILING_RANGE_DAYS=3660
API_QUERY_TIMEOUT_SECONDS=10

# Local durable checkpoint path. Production may use object storage after S3A validation.
SPARK_CHECKPOINT_PATH=/checkpoints/market-bars-v2
