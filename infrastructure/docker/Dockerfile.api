FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/marketpilot
COPY pyproject.toml README.md ./
COPY src ./src
COPY services ./services
RUN pip install --no-cache-dir \
        fastapi==0.141.1 \
        'uvicorn[standard]==0.52.4' \
        PyMySQL==1.2.0 \
    && pip install --no-cache-dir --no-deps .
USER 65532:65532

CMD ["uvicorn", "services.backend_api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-server-header", "--no-access-log", "--log-level", "warning"]
