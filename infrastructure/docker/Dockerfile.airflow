FROM spark:3.5.8 AS spark-runtime

USER root
RUN mkdir -p /tmp/marketpilot-ivy && chown -R spark:spark /tmp/marketpilot-ivy
USER spark
RUN /opt/spark/bin/spark-submit \
    --master local[1] \
    --conf spark.jars.ivy=/tmp/marketpilot-ivy \
    --packages org.apache.hadoop:hadoop-aws:3.3.4 \
    /opt/spark/examples/src/main/python/pi.py 1
USER root
RUN cp /tmp/marketpilot-ivy/jars/*.jar /opt/spark/jars/

FROM apache/airflow:3.0.3

USER root
RUN apt-get update \
    && apt-get install --no-install-recommends -y openjdk-17-jre-headless procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY --from=spark-runtime /opt/spark /opt/spark
COPY --chown=airflow:root src /opt/marketpilot/src

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    SPARK_HOME=/opt/spark \
    PYTHONPATH=/opt/marketpilot/src \
    PATH=/opt/spark/bin:${PATH}

USER airflow
RUN pip install --no-cache-dir \
    apache-airflow-providers-apache-spark==5.3.3 \
    pyspark==3.5.8 \
    exchange-calendars==4.13.2 \
    PyMySQL==1.2.0
